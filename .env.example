# Copie para .env e preencha. Nada daqui vai para o Git.

# --- IA ---
ANTHROPIC_API_KEY=
# Opcional: modelo do agente (padrão no código).
AGENT_MODEL=
# Opcional: transcrição de áudio do WhatsApp (Whisper).
OPENAI_API_KEY=

# --- WhatsApp ---
# "meta" (Cloud API direto) ou "ycloud" (coexistência: o número segue no app do dono).
WHATSAPP_PROVEDOR=meta

# Meta Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# YCloud
YCLOUD_API_KEY=
YCLOUD_NUMERO=
YCLOUD_WEBHOOK_SECRET=

# --- Comportamento ---
# Piloto: só estes números falam com o agente (vazio = todos). Ex.: 5511900000001,5511900000002
ATENDER_SOMENTE=
# Celular do dono: sempre liberado.
DONO_TELEFONE=
# Minutos de silêncio do agente depois que o dono responde pelo app.
PAUSA_HUMANO_MIN=240
# Junta mensagens em rajada do mesmo contato (ms). 0 desliga.
AGRUPAR_MS=4000

# --- Cobrança ---
COBRANCA_EMPRESA=Imobiliária Exemplo
COBRANCA_FUSO=America/Sao_Paulo
# Planilha de trabalho (Google Sheets) e o OAuth com escopo de planilhas
COBRANCA_SHEET_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Estado em disco (opcional) ---
# Chave para cifrar as conversas salvas (AES-256-GCM).
STATE_KEY=
STATE_DIR=
